# Only source, reference docs, repeatable regression tests and small fixtures are
# committed. Everything regenerable (build output, caches, environments,
# generated fixtures, screenshots, logs) is ignored.

# One-off debug scripts and notes written at the repository root. The leading
# slash matters: backend/ and js/ contain real source, and an unanchored *.py
# rule would swallow it.
/*.py
/*.txt

# Throwaway probe scripts produced while iterating on a test.
scratch_*
**/scratch_*

# Python bytecode and environments.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Backend build output; regenerated by backend/build.py.
backend/dist/
backend/build/
backend/logs/
backend/.profile/
backend/inkshader.lock
backend/packaging/inkshader.ico
backend/src/inkshader/_build_info_generated.py

# Test output. Repeatable suites live in test/ as test/probe_<topic>.mjs; every
# other probe is a one-off and belongs in test/_archive/.
test/_archive/
test/*.png
test/small_project.json
test/big_project.json
test/huge_project.json
test/*_project_*.json

# Exception: the baseline project loaded by several probes on every run.
!test/InkShader_project_*.json

# Node toolchain. It serves the probes only; the frontend needs no build step.
node_modules/

# Editor and agent working data.
.omo/
.codegraph
.freebuff/
.playwright-mcp/

# OS and editor clutter.
.DS_Store
Thumbs.db
*.swp
*~
*.log
